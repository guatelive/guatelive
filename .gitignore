# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/docs
CLAUDE.md
0-EMPEZAR-AQUI.md
.claude/skills/plan-cambio/
.claude/skills/fix-rapido/
.claude/skills/triage-tareas/

# GuateLive — scripts privados (lógica de negocio)
scripts/*
scripts/data/
scripts/output/

# Excepción: los scrapers que corren vía GitHub Actions necesitan estar
# versionados para que el cron tenga el archivo — el resto de scripts/ (auto-tag,
# importers, etc.) sigue privado.
!scripts/scrape-bank-promos.ts
!scripts/bank-sources/
!scripts/bank-sources/**
# Volcados de HTML de debug (bac.ts los genera cuando el selector no matchea nada) —
# son snapshots temporales para depurar, no código, nunca se versionan.
scripts/bank-sources/.debug/

!scripts/scrape-events.ts
!scripts/event-sources/
!scripts/event-sources/**

# GuateLive — SQL sueltas de mantenimiento, corridas a mano, no versionadas como migración
supabase/scripts/
